{
  "manifest_version": 3,
  "name": "Spordle Annonceur",
  "version": "1.0.16",
  "description": "Ajoute une icône 📢 sur chaque but et punition de la feuille de match Spordle Play pour afficher en gros le texte à annoncer.",
  "content_scripts": [
    {
      "matches": [
        "*://*.spordle.com/*",
        "*://*.spordle.dev/*",
        "*://*.hisports.app/*"
      ],
      "js": ["spordle-engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
